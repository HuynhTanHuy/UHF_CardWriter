<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CareHR.UhfCardWriter.Sdk</RootNamespace>
    <AssemblyName>CareHR.UhfCardWriter.Sdk</AssemblyName>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Native binaries: vendor Form1 x86 stack (UHFPrimeReader 1.0.0.1 + hidapi x86) -->
    <None Include="Native\UHFPrimeReader.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>UHFPrimeReader.dll</Link>
    </None>
    <None Include="Native\hidapi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>hidapi.dll</Link>
    </None>
  </ItemGroup>

</Project>
