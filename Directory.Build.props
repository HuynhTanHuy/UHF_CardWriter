<Project>
  <PropertyGroup>
    <!-- Phase 1: lock all projects to x64 to match UHF Desk Reader SDK API\x64 -->
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- RID only on the WinForms host so native DLLs resolve next to a win-x64 process -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'CareHR.UhfCardWriter.App'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>

